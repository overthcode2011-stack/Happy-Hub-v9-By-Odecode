local function cambiarTexto()
    if animando then return end
    animando = true
    local currentPos = textLabel.Position -- Save current position

    -- Fade out to bottom
    local salida = TweenService:Create(textLabel, TweenInfo.new(duracion / 2), {
        TextTransparency = 1,
        Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale + 0.025, currentPos.Y.Offset)
    })
    salida:Play()
    salida.Completed:Wait()

    -- Change text and move slightly above
    index = (index % #textos) + 1
    textLabel.Text = textos[index]
    textLabel.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale - 0.025, currentPos.Y.Offset)
    textLabel.TextTransparency = 1

    -- Fade in to original position
    local entrada = TweenService:Create(textLabel, TweenInfo.new(duracion / 2), {
        TextTransparency = 0,
        Position = currentPos
    })
    entrada:Play()
    entrada.Completed:Wait()

    animando = false
end

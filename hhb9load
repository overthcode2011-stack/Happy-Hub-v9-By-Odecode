-- TextLabel
local textLabel = Instance.new("TextLabel")
textLabel.Name = "Text"
textLabel.Size = UDim2.new(0.8, 0, 0.1, 0)
textLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
textLabel.BackgroundTransparency = 1
textLabel.Text = "The best Keyless hub"
textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
textLabel.TextScaled = true
textLabel.Font = Enum.Font.BuilderSansBold
textLabel.TextTransparency = 1
textLabel.ZIndex = 2
textLabel.Parent = main

-- Textos a rotar
local textos = {
    "The best Keyless hub",
    "Use your hub without key",
    "Fast, safe and reliable"
}

local currentIndex = 1
local isAnimating = false
local tweenDuration = 0.4
local originalPos = textLabel.Position

local function changeText()
    if isAnimating then return end
    isAnimating = true

    -- Salida
    local tweenOut = TweenService:Create(textLabel, TweenInfo.new(tweenDuration/2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 1,
        Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset, originalPos.Y.Scale + 0.04, originalPos.Y.Offset)
    })
    tweenOut:Play()
    tweenOut.Completed:Wait()

    -- Cambiar texto
    currentIndex = (currentIndex % #textos) + 1
    textLabel.Text = textos[currentIndex]
    textLabel.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset, originalPos.Y.Scale - 0.04, originalPos.Y.Offset)
    textLabel.TextTransparency = 1

    -- Entrada
    local tweenIn = TweenService:Create(textLabel, TweenInfo.new(tweenDuration/2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0,
        Position = originalPos
    })
    tweenIn:Play()
    tweenIn.Completed:Wait()

    isAnimating = false
end

-- Animación inicial
TweenService:Create(textLabel, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
    TextTransparency = 0
}):Play()

task.wait(1.2)

-- Ciclo de textos
for i = 1, #textos - 1 do
    task.wait(1.7)
    changeText()
end

task.wait(1.6)

-- Fade out final
local fadeText = TweenService:Create(textLabel, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { TextTransparency = 1 })
local fadeMain = TweenService:Create(main, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })

fadeText:Play()
fadeMain:Play()

fadeMain.Completed:Wait()


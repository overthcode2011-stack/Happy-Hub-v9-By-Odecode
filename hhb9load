local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "load"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 999  -- ✅ Por encima de todas las otras GUIs
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui


-- Frame principal
local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.new(1, 0, 1, 0)
main.Position = UDim2.new(0, 0, 0, 0)
main.AnchorPoint = Vector2.new(0, 0)
main.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
main.BorderSizePixel = 0
main.ZIndex = 1
main.Parent = screenGui

-- ✅ UIGradient como hijo directo de Main (vertical)
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0,   Color3.fromRGB(0, 0, 0)),       -- Negro arriba
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(26, 77, 62)),    -- Verde agua oscuro
	ColorSequenceKeypoint.new(1,   Color3.fromRGB(10, 31, 24))     -- Verde casi negro abajo
})
gradient.Rotation = 90  -- ✅ CORREGIDO: 90° = vertical (arriba → abajo)
gradient.Parent = main  -- ✅ Hijo de Main

-- TextLabel centrado
local textLabel = Instance.new("TextLabel")
textLabel.Name = "Text"
textLabel.Size = UDim2.new(0.6, 0, 0.08, 0)
textLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
textLabel.BackgroundTransparency = 1
textLabel.BorderSizePixel = 0 
textLabel.Text = "The best Keyless hub"
textLabel.TextColor3 = Color3.fromRGB(400,400,400)
textLabel.TextScaled = true
textLabel.Font = Enum.Font.BuilderSansBold
textLabel.TextTransparency = 1  -- empieza invisible para el fade in
textLabel.ZIndex = 2
textLabel.Parent = main


-- Textos a rotar
local textos = {
	"The best Keyless hub",
	"Use your hub without key",
	"Fastly and safe"
}

local index = 1
local animando = false
local duracion = 0.4
local posOriginal = textLabel.Position

local function cambiarTexto()
	if animando then return end
	animando = true

	-- Salida: baja y desaparece
	local salida = TweenService:Create(textLabel, TweenInfo.new(duracion / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 1,
		Position = UDim2.new(posOriginal.X.Scale, posOriginal.X.Offset, posOriginal.Y.Scale + 0.025, posOriginal.Y.Offset)
	})
	salida:Play()
	salida.Completed:Wait()

	-- Cambiar texto y reposicionar arriba
	index = (index % #textos) + 1
	textLabel.Text = textos[index]
	textLabel.Position = UDim2.new(posOriginal.X.Scale, posOriginal.X.Offset, posOriginal.Y.Scale - 0.025, posOriginal.Y.Offset)
	textLabel.TextTransparency = 1

	-- Entrada: baja hasta posición original y aparece
	local entrada = TweenService:Create(textLabel, TweenInfo.new(duracion / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 0,
		Position = posOriginal
	})
	entrada:Play()
	entrada.Completed:Wait()

	animando = false
end

-- Fade in inicial del texto
TweenService:Create(textLabel, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
	TextTransparency = 0
}):Play()

task.wait(1)

-- Ciclar por todos los textos
for _ = 1, #textos - 1 do
	task.wait(1.8)
	cambiarTexto()
end

task.wait(1.8)

-- ✅ Fade out: texto Y frame (con BackgroundTransparency para ocultar el gradiente)
TweenService:Create(textLabel, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
	TextTransparency = 1
}):Play()

local fadeOut = TweenService:Create(main, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
	BackgroundTransparency = 1
})
fadeOut:Play()
fadeOut.Completed:Wait()

-- Cargar repositorio
local url = "https://raw.githubusercontent.com/overthcode2011-stack/HHB9/refs/heads/main/main"
local success, result = pcall(function()
	loadstring(game:HttpGet(url))()
end)

if success then
	print(" # Repositorio cargado correctamente.")
else
	warn("# Error al cargar el repositorio:", result)
end

screenGui:Destroy())
